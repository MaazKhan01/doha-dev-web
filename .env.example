# WordPress (WPGraphQL) base URL — no trailing /graphql. Leave empty to render
# the static content in /content. The Azure pipeline writes this per branch
# from DEV_NEXT_PUBLIC_WP_URL / STG_NEXT_PUBLIC_WP_URL.
NEXT_PUBLIC_WP_URL=

# Optional bearer token for the CMS, if WPGraphQL requires auth.
CMS_GRAPHQL_TOKEN=

# Shared secret for the publish webhook at POST /api/revalidate.
# Send it as the x-revalidate-secret header, or ?secret= in the query string.
REVALIDATE_SECRET=

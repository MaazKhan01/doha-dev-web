# The CMS address is not configured here — it is set in lib/cms/config.ts.

# Optional bearer token for the CMS, if WPGraphQL requires auth.
CMS_GRAPHQL_TOKEN=

# Shared secret for the publish webhook at POST /api/revalidate.
# Send it as the x-revalidate-secret header, or ?secret= in the query string.
REVALIDATE_SECRET=
